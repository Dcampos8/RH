<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <defaultDocument><files><clear /><add value="index.php" /></files></defaultDocument>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment=".git" />
          <add segment="sync" />
          <add segment="sql" />
          <add segment="config.php" />
          <add segment="config.example.php" />
          <add segment="README.md" />
          <add segment=".gitignore" />
          <add segment=".gitattributes" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".py" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
